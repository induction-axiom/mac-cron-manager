#!/bin/bash
# netcheck: is the current network fine for heavy transfers?
#
#   netcheck           print the verdict; exit 0 = fine, 1 = metered/untrusted, 2 = offline
#   netcheck --trust   trust the network you're on now (remembered by its router's MAC address)
#   netcheck --list    show trusted networks
#
# Phone hotspots are always refused: iPhone Personal Hotspot (172.20.10.x), Android
# hotspots (their DHCP marks the network ANDROID_METERED) and iPhone USB / Bluetooth
# tethering. Once at least one network is trusted, only trusted networks pass.
# macOS hides the Wi-Fi name from background jobs, so networks are told apart by
# their router instead.
set -u

trusted="${MCM_CONFIG:-$HOME/.config/mac-cron-manager}/trusted-networks"

route_info=$(route -n get default 2>/dev/null)
gw=$(awk '/gateway:/ {print $2}' <<<"$route_info")
iface=$(awk '/interface:/ {print $2}' <<<"$route_info")
if [ -z "$gw" ] || [ -z "$iface" ]; then
  echo "offline"
  exit 2
fi
mac=$(arp -n "$gw" 2>/dev/null | grep -oE '([0-9a-f]{1,2}:){5}[0-9a-f]{1,2}' | head -1)
mac=${mac:-unknown}
port=$(networksetup -listallhardwareports 2>/dev/null |
       awk -v dev="$iface" '/^Hardware Port:/ {p = substr($0, 16)} $0 == "Device: " dev {print p}')

case "${1:-}" in
  --trust)
    [ "$mac" = unknown ] && { echo "can't read this network's router address, not trusting it" >&2; exit 1; }
    mkdir -p "$(dirname "$trusted")"
    if grep -qi "^$mac " "$trusted" 2>/dev/null; then
      echo "already trusted: router $mac"
    else
      echo "$mac  # ${port:-$iface} via $gw, added $(date +%F)" >>"$trusted"
      echo "trusted: router $mac (${port:-$iface} via $gw)"
    fi
    exit 0 ;;
  --list)
    cat "$trusted" 2>/dev/null || echo "no trusted networks: every network except phone hotspots is fine"
    exit 0 ;;
esac

case "$gw" in
  172.20.10.*) echo "iPhone Personal Hotspot"; exit 1 ;;
esac
case "$port" in
  *iPhone*|*Bluetooth*) echo "tethered via $port"; exit 1 ;;
esac
if ipconfig getpacket "$iface" 2>/dev/null | grep -q ANDROID_METERED; then
  echo "Android hotspot (metered)"
  exit 1
fi
if grep -qv '^\s*\(#\|$\)' "$trusted" 2>/dev/null && ! grep -qi "^$mac " "$trusted"; then
  echo "untrusted network (router $mac on ${port:-$iface})"
  exit 1
fi
echo "ok: ${port:-$iface} via $gw (router $mac)"
